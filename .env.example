# Copy to .env locally; existing process variables take precedence.
# Use one KEY=value per line. No inline comments or variable expansion.
DEBUG=True
PUBLIC_BASE_URL=http://127.0.0.1:8000
BRAMANDA_PUBLIC_BASE_URL=http://127.0.0.1:8000
# Generate a private random key once; retain it so existing invoice links keep working.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
INVOICE_SIGNING_KEY=
ESEWA_ENV=uat
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_PAYMENT_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL="BRAMANDA <no-reply@example.com>"
# Optional SMTP for welcome/allauth emails: see docs/EMAIL.md.
# Backend order confirmations; never put these in browser JavaScript.
EMAILJS_SERVICE_ID=
EMAILJS_ORDER_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
